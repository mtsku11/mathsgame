{
  "name": "number-crew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:offline": "npm run build && playwright test --config playwright.production.config.ts",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:hosted": "playwright test --config playwright.hosted.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@types/howler": "^2.2.13",
    "typescript": "^5.9.3",
    "vite": "8.0.10",
    "vitest": "4.1.6"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/titan-one": "^5.3.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.21.0"
  }
}
