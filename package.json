{
  "name": "number-crew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:offline": "npm run build && playwright test --config playwright.production.config.ts",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:hosted": "playwright test --config playwright.hosted.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "typescript": "^5.9.3",
    "vite": "8.0.10",
    "vitest": "4.1.6"
  }
}
